# Copy to the repository root as .env for local backend/worker development,
# migrations, and seeding only.
# Replace every REPLACE_* value. Use a dedicated local database with synthetic data.

NODE_ENV=development
PORT=4000

# API and worker database settings. Never use production credentials here.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=4000
DATABASE_NAME=REPLACE_WITH_LOCAL_DATABASE_NAME
DATABASE_USER=REPLACE_WITH_LOCAL_DATABASE_USER
DATABASE_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=20

# Optional for local development; required by the API in production.
REDIS_URL=

# Required by the API. Replace with a random secret of at least 32 characters.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
DEFAULT_ORG_SLUG=default
TRUST_PROXY_HOPS=0
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# Used only when explicitly running the seed command. Leave unset otherwise.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
